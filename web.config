<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config du site statique MC3 Cloud.
  Utilise uniquement par un App Service WINDOWS (IIS). Sur Linux, ce fichier est ignore (voir .htaccess).
  Un web.config invalide fait tomber tout le site (erreur 500) : tester sur le slot de staging avant la production.
-->
<configuration>

  <system.webServer>

    <!-- Page d'accueil des dossiers : index.html -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Page 404 personnalisee (le code HTTP 404 est conserve) -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Types de fichiers (un remove avant chaque mimeMap evite l'erreur 500 si le type existe deja) -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Cache par defaut : 10 minutes (pages HTML). Le dossier assets est regle plus bas. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
    </staticContent>

    <!-- Ne pas annoncer le serveur, et bloquer l'acces aux dossiers Git -->
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".github" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- En-tetes de securite -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://*.clarity.ms https://c.bing.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>

    <!--
      Redirections (module URL Rewrite, present sur App Service Windows).
      Regle 1 (301) : /xxx/index.html -> /xxx/ : une seule URL par page, evite le contenu duplique.
        La condition sur THE_REQUEST evite toute boucle avec le document par defaut :
        seule une requete qui contient reellement "index.html" dans l'URL demandee est redirigee.
      Regles 2 et 3 (302) : la racine / redirige vers /fr/ ou /en/ selon la langue du navigateur
        (premiere langue de Accept-Language). Sans en-tete (robots), on envoie vers /en/ (x-default).
    -->
    <rewrite>
      <rules>
        <rule name="Supprimer index.html" stopProcessing="true">
          <match url="^(.*/)?index\.html$" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="^[A-Z]{3,9}\s/(.*/)?index\.html[\s?]" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Racine vers FR" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_ACCEPT_LANGUAGE}" pattern="^\s*fr" />
          </conditions>
          <action type="Redirect" url="/fr/" redirectType="Temporary" />
        </rule>
        <rule name="Racine vers EN" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/en/" redirectType="Temporary" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- Dossier assets (CSS, JS, images, logos) : cache d'un jour -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>